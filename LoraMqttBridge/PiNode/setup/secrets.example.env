# /etc/lora-bridge/secrets.env — von systemd via EnvironmentFile geladen.
# NIE ins Git-Repo. Rechte: root:root 0600.
#
# Diese Werte überschreiben ALLES aus config.yaml und secrets.yaml
# (Env-Vars haben die höchste Priorität).

# LORA_BRIDGE_MQTT_HOST=192.168.50.1
# LORA_BRIDGE_MQTT_PORT=1883
LORA_BRIDGE_MQTT_USER=pi-lora
LORA_BRIDGE_MQTT_PASS=bitte-hier-echtes-passwort-eintragen
# LORA_BRIDGE_MQTT_TLS=false
# LORA_BRIDGE_MQTT_CLIENT_ID=lora-bridge-pi
# LORA_BRIDGE_LOG_LEVEL=info
