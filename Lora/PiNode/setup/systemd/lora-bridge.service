[Unit]
Description=LoRa MQTT Bridge (Pi Node)
After=network-online.target mosquitto.service
Wants=network-online.target mosquitto.service

[Service]
Type=simple
User=pi
Group=gpio
Environment=PYTHONUNBUFFERED=1
WorkingDirectory=/opt/lora-bridge/app
ExecStart=/opt/lora-bridge/bin/python -m lora_mqtt_bridge --config /etc/lora-bridge/config.yaml
Restart=on-failure
RestartSec=3
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
